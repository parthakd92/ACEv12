BROKER SCHEMA MqGet.MsgFlow


CREATE COMPUTE MODULE MqGetMsgFlow_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		SET OutputRoot.MQMD.CorrelId  = InputRoot.MQMD.MsgId;
		--SET OutputRoot.XMLNSC.WORKED_FOR.PROJECT_ID = InputRoot.XMLNSC.WORKED_FOR.PROJECT_ID;
		SET OutputRoot.XMLNSC.WORKED_FOR.PROJECT = InputRoot.XMLNSC.WORKED_FOR.PROJECT;
		RETURN TRUE;
	END;

END MODULE;
